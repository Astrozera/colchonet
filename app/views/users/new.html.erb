<h1> Cadastro </h1>
<% if @user.errors.any? %>
  <ul>
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user do |f| %>
    <div>
        <%= f.label :full_name %>
        <%= f.text_field :full_name %>
    </div>
    <div>
        <%= f.label :email %>
        <%= f.text_field :email %>
    </div>
    <div>
        <%= f.label :password %>
        <%= f.password_field :password %>
    </div>
    <div>
        <%= f.label :password_confimation %>
        <%= f.password_field :password_confimation %>
    </div>
    <div>
        <%= f.label :location %>
        <%= f.text_field :location %>
    </div>
    <div>
        <%= f.label :bio %>
        <%= f.text_area :bio %>
    </div>
    <p>
        <%= f.submit  %>
    </p>


<%end%>